<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Drop-in replacement for AddUserSecrets: same id, same folder, secrets sealed by the tir agent.
    net10.0 so apps on the current LTS runtime can use it too.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tiresias.Extensions.Configuration</RootNamespace>
    <PackageId>Tiresias.Extensions.Configuration</PackageId>
    <Description>User secrets encrypted at rest and released per process by the tir agent after consent. AddUserSecrets calls are intercepted; no code change.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tiresias.Protocol\Tiresias.Protocol.csproj" />
  </ItemGroup>

  <!-- The package carries the interceptor generator and the props that opt consumers into its namespace. -->
  <ItemGroup>
    <ProjectReference Include="..\Tiresias.Extensions.Configuration.Generator\Tiresias.Extensions.Configuration.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\Tiresias.Extensions.Configuration.Generator\bin\$(Configuration)\netstandard2.0\Tiresias.Extensions.Configuration.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="buildTransitive\Tiresias.Extensions.Configuration.props" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tiresias.Tests" />
  </ItemGroup>

</Project>
