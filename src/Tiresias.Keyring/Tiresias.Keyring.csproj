<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows only (Windows Hello via WinRT, DPAPI, session events), built on the Windows CI leg only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>tir</AssemblyName>
    <RootNamespace>Tiresias.Keyring</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tiresias.Core\Tiresias.Core.csproj" />
  </ItemGroup>

</Project>
