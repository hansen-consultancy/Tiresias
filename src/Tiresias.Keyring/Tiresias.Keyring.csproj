<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tir CLI: a thin console front over Tiresias.Agent. Windows only, built on the Windows CI leg only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>tir</AssemblyName>
    <RootNamespace>Tiresias.Keyring</RootNamespace>
    <!--
      Agent references the broker, an Exe, for solo mode. A self-contained publish then picks up the
      broker's apphost, deps.json and runtimeconfig.json from both its RID and its RID-less build
      (NETSDK1152). Only the broker's assembly is used: solo mode hosts it in-process and never runs
      Tiresias.Broker.exe, so which copy wins doesn't matter.
    -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tiresias.Agent\Tiresias.Agent.csproj" />
    <ProjectReference Include="..\Tiresias.Core\Tiresias.Core.csproj" />
  </ItemGroup>

</Project>
