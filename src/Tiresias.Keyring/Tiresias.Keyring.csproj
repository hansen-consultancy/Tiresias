<Project Sdk="Microsoft.NET.Sdk">

  <!-- The tir CLI: a thin console front over Tiresias.Agent. Windows only, built on the Windows CI leg only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>tir</AssemblyName>
    <RootNamespace>Tiresias.Keyring</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tiresias.Agent\Tiresias.Agent.csproj" />
    <ProjectReference Include="..\Tiresias.Core\Tiresias.Core.csproj" />
  </ItemGroup>

</Project>
