<Window x:Class="Tiresias.App.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Tiresias.App"
        xmlns:logic="clr-namespace:Tiresias.App.Logic"
        Title="{l:S FirstRun_WindowTitle}"
        l:WindowFit.Size="Standard"
        Icon="pack://application:,,,/Assets/tiresias.ico">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </Window.Resources>
  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{Binding StepLabel}" Style="{StaticResource CaptionText}" Margin="0,0,0,8" />

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
      <Grid>
        <!-- Welcome -->
        <StackPanel x:Name="Welcome" Tag="{x:Static logic:FirstRunStep.Welcome}">
          <TextBlock Text="{l:S FirstRun_Welcome_Title}" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock Text="{l:S FirstRun_Welcome_Body}" Style="{StaticResource BodyText}" />
          <TextBlock Text="{l:S FirstRun_Welcome_Steps}" Style="{StaticResource BodyText}" />
        </StackPanel>

        <!-- Windows Hello -->
        <StackPanel x:Name="Hello" Tag="{x:Static logic:FirstRunStep.Hello}">
          <TextBlock Text="{l:S FirstRun_Hello_Title}" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock Text="{l:S FirstRun_Hello_Body}" Style="{StaticResource BodyText}" />
          <TextBlock Text="{l:S FirstRun_Hello_Note}" Style="{StaticResource CaptionText}" />
        </StackPanel>

        <StackPanel x:Name="RecoveryCreate" Tag="{x:Static logic:FirstRunStep.RecoveryCreate}">
          <TextBlock Text="{l:S FirstRun_RecoveryCreate_Title}" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock Text="{l:S FirstRun_RecoveryCreate_Body}" Style="{StaticResource BodyText}" />
        </StackPanel>

        <StackPanel x:Name="RecoveryUnavailable" Tag="{x:Static logic:FirstRunStep.RecoveryUnavailable}">
          <TextBlock Text="{l:S FirstRun_RecoveryUnavailable_Title}" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock Text="{l:S FirstRun_RecoveryUnavailable_Body}" Style="{StaticResource BodyText}" />
        </StackPanel>

        <!-- Recovery key, shown once -->
        <StackPanel x:Name="RecoveryShow" Tag="{x:Static logic:FirstRunStep.RecoveryShow}">
          <TextBlock Text="{l:S FirstRun_RecoveryShow_Title}" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock Text="{l:S FirstRun_RecoveryShow_Body}" Style="{StaticResource BodyText}" />
          <Border Style="{StaticResource Card}">
            <TextBlock x:Name="KeyText" Text="{Binding KeyText}" FontFamily="Cascadia Mono, Consolas" FontSize="18" LineHeight="30"
                       TextWrapping="Wrap" AutomationProperties.Name="{l:S FirstRun_RecoveryShow_KeyName}" />
          </Border>
          <TextBlock Text="{l:S FirstRun_RecoveryShow_Warning}" Style="{StaticResource CaptionText}" Margin="0,0,0,12" />
          <CheckBox IsChecked="{Binding WroteItDown}" Content="{l:S FirstRun_RecoveryShow_Confirm}" />
        </StackPanel>

        <!-- Two groups asked back -->
        <StackPanel x:Name="RecoveryConfirm" Tag="{x:Static logic:FirstRunStep.RecoveryConfirm}">
          <TextBlock Text="{l:S FirstRun_RecoveryConfirm_Title}" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock Text="{l:S FirstRun_RecoveryConfirm_Body}" Style="{StaticResource BodyText}" />
          <TextBlock Text="{Binding Fingerprint}" Style="{StaticResource CaptionText}" />
          <Label x:Name="FirstGroupLabel" Content="{Binding FirstGroupLabel}" Target="{Binding ElementName=FirstGroup}" Padding="0,8,0,4" />
          <TextBox x:Name="FirstGroup" Style="{StaticResource RecoveryPaperInput}" Width="160" HorizontalAlignment="Left" CharacterCasing="Upper" MaxLength="6"
                   Text="{Binding FirstAnswer, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas"
                   AutomationProperties.LabeledBy="{Binding ElementName=FirstGroupLabel}" />
          <Label x:Name="SecondGroupLabel" Content="{Binding SecondGroupLabel}" Target="{Binding ElementName=SecondGroup}" Padding="0,8,0,4" />
          <TextBox x:Name="SecondGroup" Style="{StaticResource RecoveryPaperInput}" Width="160" HorizontalAlignment="Left" CharacterCasing="Upper" MaxLength="6"
                   Text="{Binding SecondAnswer, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas"
                   AutomationProperties.LabeledBy="{Binding ElementName=SecondGroupLabel}" />
          <Button Content="{l:S FirstRun_RecoveryConfirm_ShowAgain}" HorizontalAlignment="Left" Padding="12,6" Margin="0,16,0,0"
                  Command="{Binding ShowKeyAgainCommand}" />
        </StackPanel>

        <!-- Sealed secrets here but no recovery key: the one they were sealed with is typed -->
        <StackPanel x:Name="Restore" Tag="{x:Static logic:FirstRunStep.RecoveryRestore}">
          <TextBlock Text="{Binding RestoreTitle}" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock Text="{Binding RestoreBody}" Style="{StaticResource BodyText}" />
          <TextBox x:Name="RestoreKey" Style="{StaticResource RecoveryPaperInput}" Text="{Binding RestoreKey, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80"
                   TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" CharacterCasing="Upper"
                   AutomationProperties.Name="{l:S FirstRun_RecoveryRestore_KeyName}" />
          <TextBlock Text="{Binding Fingerprint}" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
          <TextBlock Text="{Binding RestoreResult}" Style="{StaticResource BodyText}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
          <Expander Header="{l:S FirstRun_RecoveryRestore_Lost}" Margin="0,16,0,0" Visibility="{Binding LostVisibility}">
            <StackPanel Margin="0,8,0,0">
              <TextBlock Text="{Binding LostKeyText}" Style="{StaticResource BodyText}" />
              <Button Content="{l:S FirstRun_RecoveryRestore_New}" HorizontalAlignment="Left" Padding="12,6"
                      Command="{Binding NewRecoveryKeyCommand}" Visibility="{Binding CanReplaceKey, Converter={StaticResource Visible}}" />
            </StackPanel>
          </Expander>
        </StackPanel>

        <!-- Mode -->
        <StackPanel x:Name="Mode" Tag="{x:Static logic:FirstRunStep.Mode}">
          <TextBlock Text="{l:S FirstRun_Mode_Title}" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
          <RadioButton GroupName="Mode" IsChecked="{Binding IsSolo}" Margin="0,4,0,0">
            <StackPanel>
              <TextBlock Text="{l:S FirstRun_Mode_Solo}" Style="{StaticResource SubtitleText}" />
              <TextBlock Text="{l:S FirstRun_Mode_SoloBody}" Style="{StaticResource CaptionText}" />
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="Mode" IsChecked="{Binding IsBroker}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="{l:S FirstRun_Mode_Broker}" Style="{StaticResource SubtitleText}" />
              <TextBlock Text="{l:S FirstRun_Mode_BrokerBody}" Style="{StaticResource CaptionText}" />
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="Mode" IsChecked="{Binding IsSecretsOnly}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="{l:S FirstRun_Mode_SecretsOnly}" Style="{StaticResource SubtitleText}" />
              <TextBlock Text="{l:S FirstRun_Mode_SecretsOnlyBody}" Style="{StaticResource CaptionText}" />
            </StackPanel>
          </RadioButton>
        </StackPanel>

        <!-- Resumed solo setup: type the key back -->
        <StackPanel x:Name="RecoveryType" Tag="{x:Static logic:FirstRunStep.RecoveryType}">
          <TextBlock Text="{l:S FirstRun_RecoveryType_Title}" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock Text="{l:S FirstRun_RecoveryType_Body}" Style="{StaticResource BodyText}" />
          <TextBox x:Name="TypedKey" Text="{Binding TypedKey, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80"
                   TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" CharacterCasing="Upper"
                   AutomationProperties.Name="{l:S FirstRun_RecoveryType_KeyName}" />
          <Expander Header="{l:S FirstRun_RecoveryType_Lost}" Margin="0,16,0,0">
            <StackPanel Margin="0,8,0,0">
              <TextBlock Text="{Binding LostKeyText}" Style="{StaticResource BodyText}" />
              <Button Content="{l:S FirstRun_RecoveryType_Replace}" HorizontalAlignment="Left" Padding="12,6"
                      Command="{Binding NewRecoveryKeyCommand}" Visibility="{Binding CanReplaceKey, Converter={StaticResource Visible}}" />
              <Button Content="{l:S FirstRun_RecoveryType_SkipSolo}" HorizontalAlignment="Left" Padding="12,6" Margin="0,8,0,0"
                      Command="{Binding SkipSoloCommand}" />
            </StackPanel>
          </Expander>
        </StackPanel>

        <!-- The admin tier, optional: Set up (UAC) or Not now -->
        <StackPanel x:Name="AdminTierPanel" Tag="{x:Static logic:FirstRunStep.AdminTier}">
          <TextBlock Text="{l:S FirstRun_AdminTier_Title}" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock Text="{l:S FirstRun_AdminTier_Body}" Style="{StaticResource BodyText}" />
          <TextBlock Text="{l:S FirstRun_AdminTier_Adds}" Style="{StaticResource BodyText}" />
          <TextBlock Text="{l:S FirstRun_AdminTier_Note}" Style="{StaticResource CaptionText}" />
        </StackPanel>

        <!-- Done -->
        <StackPanel x:Name="Done" Tag="{x:Static logic:FirstRunStep.Done}">
          <TextBlock Text="{l:S FirstRun_Done_Title}" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock Text="{Binding DoneText}" Style="{StaticResource BodyText}" />
          <TextBlock Text="{l:S FirstRun_Done_Tray}" Style="{StaticResource BodyText}" />
          <TextBlock Text="{l:S FirstRun_Done_Next}" Style="{StaticResource CaptionText}" />
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <TextBlock Grid.Row="2" Text="{Binding Message}" Style="{StaticResource BodyText}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
               Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive" />

    <StackPanel Grid.Row="3" Style="{StaticResource ButtonRow}">
      <Button Style="{DynamicResource AccentButtonStyle}" MinWidth="120" Padding="12,6" Content="{Binding PrimaryLabel}"
              Command="{Binding PrimaryCommand}" IsDefault="True" />
      <Button Style="{StaticResource RowButton}" Content="{Binding CloseLabel}" IsCancel="True" Click="OnClose" />
    </StackPanel>
  </Grid>
</Window>
