<Window x:Class="Tiresias.App.Views.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Tiresias.App"
        Title="{l:S Consent_WindowTitle}"
        Width="520" SizeToContent="Height" MaxHeight="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        Icon="pack://application:,,,/Assets/tiresias.ico">
  <Window.Resources>
    <!-- Reads as the mono text it replaces, but can be selected and copied. -->
    <Style x:Key="SelectableText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Window.Resources>
  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock x:Name="Heading" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
      <!-- tir run's whole command line, as tir reports it: what the program is about to be asked to do. -->
      <TextBox x:Name="Command" Style="{StaticResource SelectableText}" Margin="0,4,0,0" Visibility="Collapsed"
               AutomationProperties.Name="{l:S Consent_CommandLabel}" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock x:Name="ProgramLabel" Style="{StaticResource CaptionText}" />
        <!-- The file name first, so it reads at a glance; the folder below says which copy it is. -->
        <TextBlock x:Name="ProgramName" Style="{StaticResource MonoText}" FontWeight="SemiBold" Margin="0,2,0,0"
                   AutomationProperties.LabeledBy="{Binding ElementName=ProgramLabel}" />
        <TextBox x:Name="ProgramFolder" Style="{StaticResource SelectableText}" Margin="0,2,0,0" Opacity="0.75" />
        <TextBlock x:Name="OpenFolderLine" Margin="0,4,0,0">
          <Hyperlink Click="OnOpenFolder"><Run Text="{l:S Consent_OpenFolder}" /></Hyperlink>
        </TextBlock>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2">
      <TextBlock x:Name="ListLabel" Style="{StaticResource SubtitleText}" />
      <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Focusable="False">
        <ItemsControl x:Name="Items" Focusable="False" AutomationProperties.LabeledBy="{Binding ElementName=ListLabel}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Style="{StaticResource MonoText}" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock x:Name="Note" Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
    </StackPanel>

    <TextBlock x:Name="Countdown" Grid.Row="3" Style="{StaticResource CaptionText}" Margin="0,16,0,0" />

    <StackPanel Grid.Row="4" Style="{StaticResource ButtonRow}">
      <Button x:Name="AllowSession" Style="{StaticResource RowButton}" Content="{l:S Consent_AllowSession}" Click="OnAllowSession" />
      <Button x:Name="AllowOnce" Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0" MinWidth="96" Padding="12,6"
              Content="{l:S Consent_AllowOnce}" Click="OnAllowOnce" />
      <!-- Deny is the cancel button (Esc, closing the window) and nothing is the default: Enter never approves by accident. -->
      <Button x:Name="DenyButton" Style="{StaticResource RowButton}" Content="{l:S Consent_Deny}" IsCancel="True" Click="OnDeny" />
    </StackPanel>
  </Grid>
</Window>
