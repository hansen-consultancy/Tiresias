<Window x:Class="Tiresias.App.Views.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Tiresias.App"
        Title="{l:S Consent_WindowTitle}"
        Width="520" SizeToContent="Height" MaxHeight="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        Icon="pack://application:,,,/Assets/tiresias.ico">
  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="Heading" Grid.Row="0" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />

    <Border Grid.Row="1" Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock x:Name="ProgramLabel" Style="{StaticResource CaptionText}" />
        <TextBlock x:Name="ProgramPath" Style="{StaticResource MonoText}" Margin="0,2,0,0"
                   AutomationProperties.LabeledBy="{Binding ElementName=ProgramLabel}" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2">
      <TextBlock x:Name="ListLabel" Style="{StaticResource SubtitleText}" />
      <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Focusable="False">
        <ItemsControl x:Name="Items" Focusable="False" AutomationProperties.LabeledBy="{Binding ElementName=ListLabel}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Style="{StaticResource MonoText}" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock x:Name="Note" Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
    </StackPanel>

    <TextBlock x:Name="Countdown" Grid.Row="3" Style="{StaticResource CaptionText}" Margin="0,16,0,0" />

    <StackPanel Grid.Row="4" Style="{StaticResource ButtonRow}">
      <Button x:Name="AllowSession" Style="{StaticResource RowButton}" Content="{l:S Consent_AllowSession}" Click="OnAllowSession" />
      <Button x:Name="AllowOnce" Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0" MinWidth="96" Padding="12,6"
              Content="{l:S Consent_AllowOnce}" Click="OnAllowOnce" />
      <!-- Deny is the cancel button (Esc, closing the window) and nothing is the default: Enter never approves by accident. -->
      <Button x:Name="DenyButton" Style="{StaticResource RowButton}" Content="{l:S Consent_Deny}" IsCancel="True" Click="OnDeny" />
    </StackPanel>
  </Grid>
</Window>
