<UserControl x:Class="Tiresias.App.Views.DetailsPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Tiresias.App">
  <!-- The selected row in full, below a list too narrow to show it: every value wraps and can be selected; Copy takes them all. -->
  <Border x:Name="Card" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="12,6" Visibility="Collapsed">
    <DockPanel>
      <Button DockPanel.Dock="Right" Style="{StaticResource RowButton}" VerticalAlignment="Top" Margin="12,0,0,0"
              Content="{l:S Status_CopyDetails}" Click="OnCopy" />
      <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <ItemsControl x:Name="Lines" Focusable="False" Grid.IsSharedSizeScope="True">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource CaptionText}" Margin="0,2,16,2" />
                <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" Style="{StaticResource SelectableText}" Margin="0,2"
                         AutomationProperties.Name="{Binding Label}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
