<Window x:Class="Tiresias.App.Views.AskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Tiresias.App"
        Title="{l:S App_Name}"
        l:WindowFit.Size="Narrow" ResizeMode="NoResize" ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/tiresias.ico">
  <StackPanel Margin="{StaticResource PagePadding}">
    <TextBlock x:Name="Heading" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
    <TextBlock x:Name="Body" Style="{StaticResource BodyText}" />
    <StackPanel Style="{StaticResource ButtonRow}">
      <Button x:Name="Primary" Style="{DynamicResource AccentButtonStyle}" MinWidth="96" Padding="12,6" Click="OnPrimary" />
      <Button x:Name="Secondary" Style="{StaticResource RowButton}" Click="OnSecondary" />
      <Button x:Name="CancelButton" Style="{StaticResource RowButton}" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
