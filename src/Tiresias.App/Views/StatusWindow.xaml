<Window x:Class="Tiresias.App.Views.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Tiresias.App"
        Title="{l:S Status_WindowTitle}"
        l:WindowFit.Size="Wide" l:WindowFit.Tall="True"
        Icon="pack://application:,,,/Assets/tiresias.ico">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style x:Key="NavIcon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Width" Value="28" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="NavCount" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- A place on the left: a subtle fill when picked, and the accent bar that says which (docs/app-design.md, rule 10). -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Back" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
              <Grid>
                <Rectangle x:Name="Bar" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Margin="-12,0,0,0" HorizontalAlignment="Left"
                           Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                <ContentPresenter />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- One finding as a card. One is open at a time (docs/app-design.md, rule 8): the open one says
         what it is, where it stands and its fix; the others are one line to click. -->
    <DataTemplate x:Key="FindingTemplate">
      <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,8" AutomationProperties.Name="{Binding Spoken}">
        <Grid>
          <Button Visibility="{Binding ClosedVisibility}" Click="OnOpenFinding" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch" Padding="16,12" Background="Transparent" BorderThickness="0"
                  AutomationProperties.Name="{Binding Spoken}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource Badge}" Background="{DynamicResource SubtleFillColorTertiaryBrush}" Visibility="{Binding NumberVisibility}">
                <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </Border>
              <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                         Foreground="{Binding Brush}" VerticalAlignment="Center" Visibility="{Binding GlyphVisibility}" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding FixLabel}" Style="{StaticResource CaptionText}" Margin="12,0,0,0" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                         Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
          </Button>

          <Grid Visibility="{Binding OpenVisibility}" Margin="16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="34" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Badge}" VerticalAlignment="Top" Background="{DynamicResource AccentFillColorDefaultBrush}"
                    Visibility="{Binding NumberVisibility}">
              <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                       Foreground="{Binding Brush}" VerticalAlignment="Top" Margin="0,2,0,0" Visibility="{Binding GlyphVisibility}" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
              <!-- What it is in plain words, then where it stands and where the fix takes it. -->
              <TextBlock Text="{Binding Detail}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,4,0,0"
                         Visibility="{Binding DetailVisibility}" />
              <TextBlock Style="{StaticResource CaptionText}" ToolTip="{Binding MovesMeaning}" Margin="0,4,0,0" TextWrapping="Wrap">
                <Run Text="{Binding MovesNow, Mode=OneWay}" /><Run Text="{Binding MovesArrow, Mode=OneWay}" /><Run
                     Text="{Binding MovesBetter, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
              </TextBlock>
              <!-- The fix leads; Details and Dismiss sit beside it, hidden while a reason is being typed. -->
              <WrapPanel Margin="0,10,0,0" Visibility="{Binding ActionsVisibility}">
                <Button Style="{DynamicResource AccentButtonStyle}" Padding="12,4" Margin="0,0,8,0" Content="{Binding FixLabel}"
                        AutomationProperties.Name="{Binding FixName}" Visibility="{Binding FixVisibility}" Click="OnReview" />
                <ToggleButton x:Name="DetailsToggle" Style="{StaticResource DisclosureToggle}" Margin="0,0,8,0"
                              Content="{l:S Finding_Details}" Visibility="{Binding MembersVisibility}" />
                <Button Padding="12,4" Background="Transparent" BorderThickness="0" Content="{Binding DismissLabel}"
                        AutomationProperties.Name="{Binding DismissName}" Click="OnDismiss" />
                <Button Padding="12,4" Background="Transparent" BorderThickness="0" Content="{Binding TrustLabel}"
                        ToolTip="{Binding TrustTip}" AutomationProperties.HelpText="{Binding TrustTip}"
                        Visibility="{Binding TrustVisibility}" Click="OnTrust" />
              </WrapPanel>
              <StackPanel Margin="0,8,0,0" Visibility="{Binding IsChecked, ElementName=DetailsToggle, Converter={StaticResource Visible}}">
                <!-- A group's members, each with its own fix; DynamicResource because this template is still being read. -->
                <ItemsControl ItemsSource="{Binding Members}" Focusable="False" ItemTemplate="{DynamicResource FindingTemplate}" />
              </StackPanel>
              <StackPanel Margin="0,8,0,0" Visibility="{Binding DismissingVisibility}">
                <TextBlock Text="{l:S Finding_ReasonLabel}" Style="{StaticResource CaptionText}" />
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,4,0,0"
                         AutomationProperties.Name="{l:S Finding_ReasonName}" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <Button Padding="12,4" Content="{l:S Finding_ConfirmDismiss}" IsEnabled="{Binding CanDismiss}" Click="OnConfirmDismiss" />
                  <Button Padding="12,4" Margin="8,0,0,0" Content="{l:S Common_Cancel}" Click="OnCancelDismiss" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate x:Key="CheckTemplate">
      <Grid Margin="0,6" AutomationProperties.Name="{Binding Spoken}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="28" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                   Foreground="{Binding Brush}" VerticalAlignment="Top" Margin="0,2,0,0" />
        <StackPanel Grid.Column="1">
          <TextBlock Style="{StaticResource SubtitleText}" Margin="0">
            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" - " /><Run Text="{Binding StatusText, Mode=OneWay}" />
          </TextBlock>
          <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" />
        </StackPanel>
        <Button Grid.Column="2" VerticalAlignment="Center" Margin="12,0,4,0" Padding="12,4"
                Content="{l:S Status_Review}" AutomationProperties.Name="{Binding ReviewName}"
                Visibility="{Binding ReviewVisibility}" Click="OnReview" />
        <Button Grid.Column="2" VerticalAlignment="Center" Margin="12,0,4,0" Padding="12,4"
                Content="{l:S Status_CopyCommand}" ToolTip="{Binding Command}" AutomationProperties.Name="{Binding CopyName}"
                Visibility="{Binding CopyVisibility}" Click="OnCopyCommand" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <!-- One window (docs/app-design.md, rule 10): the places on the left, the page on a lighter panel on the right. -->
  <Grid>
    <Grid.ColumnDefinitions>
      <!-- Fits "Environment variables" and a two-digit count untrimmed, at 100% text size. -->
      <ColumnDefinition Width="228" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <!-- Only the areas this machine uses (HomeAreas); the rest are reached through Add.... About sits at the bottom. -->
    <ListBox x:Name="Nav" Margin="8,12,8,12" BorderThickness="0" Background="Transparent" SelectionChanged="OnNav"
             ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             AutomationProperties.Name="{l:S Nav_Name}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <DockPanel LastChildFill="False" />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBoxItem x:Name="NavHome" Tag="Home" DockPanel.Dock="Top">
        <DockPanel><TextBlock Text="&#xE80F;" Style="{StaticResource NavIcon}" /><TextBlock Text="{l:S Nav_Home}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel>
      </ListBoxItem>
      <ListBoxItem x:Name="NavSecrets" Tag="Secrets" DockPanel.Dock="Top" Visibility="{Binding SecretsVisibility}" ToolTip="{Binding SecretsCountTip}">
        <DockPanel><TextBlock Text="&#xE72E;" Style="{StaticResource NavIcon}" /><TextBlock DockPanel.Dock="Right" Text="{Binding SecretsCount}" Style="{StaticResource NavCount}" AutomationProperties.Name="{Binding SecretsCountTip}" /><TextBlock Text="{l:S Nav_Secrets}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel>
      </ListBoxItem>
      <ListBoxItem x:Name="NavServices" Tag="Services" DockPanel.Dock="Top" Visibility="{Binding ServicesVisibility}" ToolTip="{Binding ServicesCountTip}">
        <DockPanel><TextBlock Text="&#xE968;" Style="{StaticResource NavIcon}" /><TextBlock DockPanel.Dock="Right" Text="{Binding ServicesCount}" Style="{StaticResource NavCount}" AutomationProperties.Name="{Binding ServicesCountTip}" /><TextBlock Text="{l:S Nav_Services}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel>
      </ListBoxItem>
      <ListBoxItem x:Name="NavEnvironment" Tag="Environment" DockPanel.Dock="Top" Visibility="{Binding EnvironmentVisibility}" ToolTip="{Binding VariablesCountTip}">
        <DockPanel><TextBlock Text="&#xE8A4;" Style="{StaticResource NavIcon}" /><TextBlock DockPanel.Dock="Right" Text="{Binding VariablesCount}" Style="{StaticResource NavCount}" AutomationProperties.Name="{Binding VariablesCountTip}" /><TextBlock Text="{l:S Nav_Environment}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel>
      </ListBoxItem>
      <ListBoxItem x:Name="NavActivity" Tag="Activity" DockPanel.Dock="Top" Visibility="{Binding ActivityVisibility}" ToolTip="{Binding ActivityCountTip}">
        <DockPanel><TextBlock Text="&#xE81C;" Style="{StaticResource NavIcon}" /><TextBlock DockPanel.Dock="Right" Text="{Binding ActivityCount}" Style="{StaticResource NavCount}" AutomationProperties.Name="{Binding ActivityCountTip}" /><TextBlock Text="{l:S Nav_Activity}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel>
      </ListBoxItem>
      <ListBoxItem x:Name="NavInstalled" Tag="Installed" DockPanel.Dock="Top">
        <DockPanel><TextBlock Text="&#xE71D;" Style="{StaticResource NavIcon}" /><TextBlock Text="{l:S Nav_Installed}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel>
      </ListBoxItem>
      <ListBoxItem x:Name="NavAbout" Tag="About" DockPanel.Dock="Bottom">
        <DockPanel><TextBlock Text="&#xE946;" Style="{StaticResource NavIcon}" /><TextBlock Text="{l:S Status_About}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></DockPanel>
      </ListBoxItem>
    </ListBox>

    <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
    <Grid>
    <!-- The other places, one at a time; each brings its own padding. -->
    <ContentControl x:Name="PageHost" Focusable="False" Visibility="Collapsed" />

  <!-- Header, one scrolling body, footer (docs/app-design.md, rule 2): no list in the body scrolls by itself. -->
  <Grid x:Name="HomePage" Margin="36,24,36,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Where things stand and how many need you; the body starts with the next step (rule 8). -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <!-- One line: mode, build and start with Windows live in About (docs/app-design.md, rule 5). -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <!-- The lock at a glance: open and green while unlocked. -->
          <Border Width="32" Height="32" CornerRadius="16" VerticalAlignment="Center" AutomationProperties.Name="{Binding Headline}">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="&#xE72E;" />
                  <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
                      <Setter Property="Text" Value="&#xE785;" />
                      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>
          <TextBlock Text="{Binding Headline}" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Padding="12,4" Margin="12,0,0,0" Content="{Binding LockLabel}" Command="{Binding ToggleLockCommand}" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Style="{DynamicResource AccentButtonStyle}" Padding="12,4" Margin="12,0,0,0" Content="{l:S Tray_Add}"
                Click="OnAdd" VerticalAlignment="Center" />
      </Grid>
      <TextBlock Text="{Binding Summary}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,20,0,8"
                 AutomationProperties.HeadingLevel="Level1" />
      <StackPanel Orientation="Horizontal">
        <ProgressBar Width="240" Height="4" Minimum="0" Maximum="{Binding CheckCount, Mode=OneWay}" Value="{Binding PassCount, Mode=OneWay}"
                     IsIndeterminate="{Binding IsRunning}" VerticalAlignment="Center" AutomationProperties.Name="{Binding ProgressText}" />
        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel>
        <!-- Why developer tools appeared, once (docs/developer-tools.md). -->
        <Border Style="{StaticResource Card}" Visibility="{Binding DeveloperLineVisibility}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="{l:S DevTools_Close}" Padding="12,6" Margin="8,0,0,0" VerticalAlignment="Center" Click="OnDeveloperClose" />
            <Button DockPanel.Dock="Right" Content="{l:S DevTools_Change}" Padding="12,6" Margin="12,0,0,0" VerticalAlignment="Center" Click="OnDeveloperChange" />
            <TextBlock Text="{Binding DeveloperLine}" Style="{StaticResource BodyText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0" />
          </DockPanel>
        </Border>

        <!-- Sealed secrets this PC's Windows Hello can't open: only the recovery key gives them back. -->
        <Border Style="{StaticResource Card}" Visibility="{Binding RestoreVisibility}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding RestoreTitle}" Style="{StaticResource SubtitleText}" />
              <TextBlock Text="{Binding RestoreText}" Style="{StaticResource CaptionText}" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" Padding="12,6" Margin="12,0,0,0" MinWidth="96"
                    Content="{Binding RestoreButton}" Click="OnRestore" />
          </Grid>
        </Border>

        <!-- After "This wasn't me": the lockdown until the next unlock, and the programs refused without asking. -->
        <Border Style="{StaticResource Card}" Visibility="{Binding GuardVisibility}">
          <StackPanel>
            <TextBlock x:Name="BlockedTitle" Text="{l:S Status_BlockedTitle}" Style="{StaticResource SubtitleText}" />
            <TextBlock Text="{Binding GuardMessage}" Style="{StaticResource CaptionText}" />
            <TextBlock Text="{l:S Status_LockedDown}" Style="{StaticResource CaptionText}" Visibility="{Binding LockedDownVisibility}" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Blocked}" Focusable="False" AutomationProperties.LabeledBy="{Binding ElementName=BlockedTitle}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBox Text="{Binding Path, Mode=OneWay}" Style="{StaticResource SelectableText}" />
                      <TextBlock Text="{Binding Since}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" Padding="12,4"
                            Content="{l:S Status_Unblock}" AutomationProperties.Name="{Binding UnblockName}" Click="OnUnblock" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Containers: looking inside the Docker engine is opt-in (docs/containers-and-vms.md, "Consent"). -->
        <Border Style="{StaticResource Card}" Visibility="{Binding ReachVisibility}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{l:S Reach_Title}" Style="{StaticResource SubtitleText}" />
              <TextBlock Text="{Binding ReachText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
            </StackPanel>
            <!-- The daily choice sits beside the button it repeats, so the card stays one row high. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <CheckBox Content="{l:S Reach_Daily}" IsChecked="{Binding IsReachDaily}" Visibility="{Binding ReachDailyVisibility}"
                        VerticalAlignment="Center" Margin="0,0,12,0" />
              <Button Padding="12,6" MinWidth="96" Content="{l:S Reach_CheckNow}" Click="OnLookInside" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Decoys: fake credentials that work nowhere, so a program using one names itself (docs/decoys.md). Links, not buttons (rule 11). -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock x:Name="DecoysTitle" Text="{l:S Decoys_Title}" Style="{StaticResource SubtitleText}" />
            <TextBlock Text="{l:S Decoys_Intro}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Decoys}" Focusable="False" Grid.IsSharedSizeScope="True" Margin="0,4,0,0"
                          AutomationProperties.LabeledBy="{Binding ElementName=DecoysTitle}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- One line per decoy: what it is, where (selectable), since when. -->
                  <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="DecoyName" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBox Grid.Column="1" Text="{Binding Where, Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="12"
                             TextWrapping="NoWrap" VerticalAlignment="Center" ToolTip="{Binding Where}" />
                    <TextBlock Grid.Column="2" Text="{Binding Since}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="16,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <WrapPanel Margin="0,4,0,0">
              <ItemsControl ItemsSource="{Binding DecoyLinks}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Margin="0,0,20,0"><Hyperlink Click="OnPlaceDecoy"><Run Text="{Binding Label, Mode=OneWay}" /></Hyperlink></TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Visibility="{Binding DecoysRemovableVisibility}">
                <Hyperlink Click="OnRemoveDecoys"><Run Text="{l:S Decoys_Remove}" /></Hyperlink>
              </TextBlock>
              <TextBlock Margin="12,0,0,0" Visibility="{Binding DecoysEnrollVisibility}">
                <Hyperlink Click="OnEnrollDecoys"><Run Text="{l:S Decoys_Enroll}" /></Hyperlink>
              </TextBlock>
            </WrapPanel>
            <TextBox Text="{Binding DecoyMessage, Mode=OneWay}" Style="{StaticResource SelectableText}" TextWrapping="Wrap"
                     Visibility="{Binding DecoyMessageVisibility}" Margin="0,4,0,0" />
          </StackPanel>
        </Border>

        <!-- Findings: deliveries weaker than they could be, each with its fix and Dismiss with a reason. -->
        <ItemsControl ItemsSource="{Binding Findings}" Focusable="False" ItemTemplate="{StaticResource FindingTemplate}"
                      AutomationProperties.Name="{Binding Summary}" />
        <Button HorizontalAlignment="Left" Padding="12,4" Margin="0,0,0,8" Content="{Binding MoreFindingsLabel}"
                Visibility="{Binding MoreFindingsVisibility}" Click="OnMoreFindings" />
        <TextBox Text="{Binding FindingMessage, Mode=OneWay}" Style="{StaticResource SelectableText}" TextWrapping="Wrap"
                 Visibility="{Binding FindingMessageVisibility}" Margin="0,0,0,8" />

        <!-- Checks that need a look stay in view; the passing and the dismissed fold into one line each. -->
        <ItemsControl ItemsSource="{Binding Checks}" Focusable="False" ItemTemplate="{StaticResource CheckTemplate}"
                      AutomationProperties.Name="{l:S Status_ChecksName}" />
        <!-- The passing and the dismissed open from the links at the foot of the page. -->
        <StackPanel Visibility="{Binding ShowPassed, Converter={StaticResource Visible}}" Margin="0,8,0,0">
          <TextBlock Text="{Binding PassedHeader}" Style="{StaticResource SubtitleText}" AutomationProperties.HeadingLevel="Level2" />
          <ItemsControl ItemsSource="{Binding Passed}" Focusable="False" ItemTemplate="{StaticResource CheckTemplate}" />
        </StackPanel>
        <StackPanel Visibility="{Binding ShowDismissed, Converter={StaticResource Visible}}" Margin="0,8,0,0">
          <TextBlock Text="{Binding DismissedHeader}" Style="{StaticResource SubtitleText}" AutomationProperties.HeadingLevel="Level2" />
          <ItemsControl ItemsSource="{Binding Dismissed}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Reason}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" Padding="12,4"
                          Content="{Binding RestoreLabel}" AutomationProperties.Name="{Binding RestoreName}" Click="OnRestoreFinding" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- Links, not buttons: the page's one button row is the open finding's (docs/app-design.md, rule 11). Escape closes. -->
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Margin="0,0,20,0" Visibility="{Binding PassedVisibility}">
          <Hyperlink Command="{Binding TogglePassedCommand}"><Run Text="{Binding PassedHeader, Mode=OneWay}" /></Hyperlink>
        </TextBlock>
        <TextBlock Visibility="{Binding DismissedVisibility}">
          <Hyperlink Command="{Binding ToggleDismissedCommand}"><Run Text="{Binding DismissedHeader, Mode=OneWay}" /></Hyperlink>
        </TextBlock>
      </StackPanel>
      <TextBlock Grid.Column="1">
        <Hyperlink Command="{Binding RunCommand}"><Run Text="{l:S Status_RunAgain}" /></Hyperlink>
      </TextBlock>
    </Grid>
  </Grid>
  </Grid>
  </Border>
  </Grid>
</Window>
