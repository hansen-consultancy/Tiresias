<Window x:Class="Tiresias.App.Views.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Tiresias.App"
        Title="{l:S Recovery_WindowTitle}"
        Width="600" Height="520" MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/tiresias.ico">
  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel>
        <TextBlock Text="{l:S Recovery_Heading}" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Text="{l:S Recovery_Body}" Style="{StaticResource BodyText}" />
        <TextBox x:Name="TypedKey" Text="{Binding TypedKey, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="80"
                 TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" CharacterCasing="Upper"
                 AutomationProperties.Name="{l:S Recovery_KeyName}" />
        <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyText}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="{l:S Recovery_Services}" Style="{StaticResource CaptionText}" />
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="1" Text="{Binding Message}" Style="{StaticResource BodyText}" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
               Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive" />

    <StackPanel Grid.Row="2" Style="{StaticResource ButtonRow}">
      <Button Style="{DynamicResource AccentButtonStyle}" MinWidth="120" Padding="12,6" Content="{l:S Recovery_Restore}"
              Command="{Binding RestoreCommand}" IsDefault="True" />
      <Button Style="{StaticResource RowButton}" Content="{l:S Common_Close}" IsCancel="True" Click="OnClose" />
    </StackPanel>
  </Grid>
</Window>
