<UserControl x:Class="Tiresias.App.Views.AboutPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Tiresias.App"
        xmlns:v="clr-namespace:Tiresias.App.Views">
  <!-- One scrolling body and a fixed footer (docs/app-design.md, rule 2): the release notes grow with the page
       instead of taking whatever height is left, so a short window still reaches every card. -->
  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel>
    <TextBlock x:Name="Heading" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
    <TextBlock x:Name="Summary" Style="{StaticResource BodyText}" />

    <StackPanel>
    <!-- Settings that used to fill Home's banner (docs/app-design.md, rule 5). -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <CheckBox x:Name="StartWithWindowsBox" Content="{l:S Status_StartWithWindows}" Checked="OnStartWithWindows" Unchecked="OnStartWithWindows" />
        <TextBlock x:Name="StartWithWindowsNote" Style="{StaticResource CaptionText}" />
      </StackPanel>
    </Border>
    <!-- Developer tools appear on a developer's PC; this overrides the detection (docs/developer-tools.md). -->
    <Border Style="{StaticResource Card}">
      <!-- The choice beside its heading; why it shows and what it covers in one caption below. -->
      <StackPanel>
        <DockPanel>
          <ComboBox x:Name="DeveloperToolsBox" DockPanel.Dock="Right" MinWidth="260" Margin="12,0,0,0" SelectionChanged="OnDeveloperTools"
                    VerticalAlignment="Center" AutomationProperties.Name="{l:S DevTools_Heading}">
            <ComboBoxItem Content="{l:S DevTools_Auto}" />
            <ComboBoxItem Content="{l:S DevTools_On}" />
            <ComboBoxItem Content="{l:S DevTools_Off}" />
          </ComboBox>
          <TextBlock Text="{l:S DevTools_Heading}" Style="{StaticResource SubtitleText}" Margin="0" VerticalAlignment="Center"
                     AutomationProperties.HeadingLevel="Level2" />
        </DockPanel>
        <TextBlock Style="{StaticResource CaptionText}" Margin="0,6,0,0">
          <Run x:Name="DeveloperToolsReason" /> <Run Text="{l:S DevTools_Note}" />
        </TextBlock>
      </StackPanel>
    </Border>
    <!-- The Azure CLI never signs itself out; the app can, as Tiresias locks or after idle time (docs/desktop-app.md). -->
    <Border x:Name="AzSignOutCard" Style="{StaticResource Card}">
      <StackPanel>
        <DockPanel>
          <ComboBox x:Name="AzSignOutIdleBox" DockPanel.Dock="Right" MinWidth="120" Margin="8,0,0,0" SelectionChanged="OnAzSignOut"
                    VerticalAlignment="Center" AutomationProperties.Name="{l:S AzSignOut_IdleTime}" />
          <ComboBox x:Name="AzSignOutBox" DockPanel.Dock="Right" MinWidth="260" Margin="12,0,0,0" SelectionChanged="OnAzSignOut"
                    VerticalAlignment="Center" AutomationProperties.Name="{l:S AzSignOut_Heading}">
            <ComboBoxItem Content="{l:S AzSignOut_Off}" />
            <ComboBoxItem Content="{l:S AzSignOut_OnLock}" />
            <ComboBoxItem Content="{l:S AzSignOut_Idle}" />
          </ComboBox>
          <TextBlock Text="{l:S AzSignOut_Heading}" Style="{StaticResource SubtitleText}" Margin="0" VerticalAlignment="Center"
                     AutomationProperties.HeadingLevel="Level2" />
        </DockPanel>
        <TextBlock x:Name="AzSignOutNote" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
      </StackPanel>
    </Border>
    <!-- Out-of-band alerts (docs/alerts.md): adding a sink is a sealed save behind Windows Hello; muting and removing are not. -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{l:S Alerts_Heading}" Style="{StaticResource SubtitleText}" AutomationProperties.HeadingLevel="Level2" />
        <TextBlock x:Name="AlertsText" Style="{StaticResource BodyText}" />
        <ListBox x:Name="AlertSinks" Style="{StaticResource PickList}" AutomationProperties.Name="{l:S Alerts_Heading}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Content="{l:S Alerts_Test}" Padding="10,4" Margin="8,0,0,0" Tag="{Binding Id}" Click="OnAlertTest" />
                  <Button Content="{Binding MuteLabel}" Padding="10,4" Margin="8,0,0,0" Tag="{Binding Id}" Click="OnAlertMute" />
                  <Button Content="{l:S Alerts_Remove}" Padding="10,4" Margin="8,0,0,0" Tag="{Binding Id}" Click="OnAlertRemove" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" Margin="0" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <v:DetailsPanel Fields="{Binding SelectedItem.Details, ElementName=AlertSinks}" />
        <TextBlock x:Name="AlertsOutcome" Style="{StaticResource CaptionText}" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal">
          <Button x:Name="AlertsAddNtfy" Content="{l:S Alerts_AddNtfy}" Padding="12,6" Click="OnAlertAdd" />
          <Button x:Name="AlertsAdd" Content="{l:S Alerts_AddWebhook}" Padding="12,6" Margin="8,0,0,0" Click="OnAlertAdd" />
          <Button x:Name="AlertsAddLcdHub" Content="{l:S Alerts_AddLcdHub}" Padding="12,6" Margin="8,0,0,0" Click="OnAlertAdd" />
        </StackPanel>
      </StackPanel>
    </Border>
    <!-- The optional admin tier (docs/admin-tier.md): its state, and set up, update or remove, each behind a UAC prompt. -->
    <Border Style="{StaticResource Card}">
      <!-- State and buttons on one row; what it is for, in one caption, whatever the state. -->
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
          <Button x:Name="AdminTierSetUp" Content="{l:S About_AdminTier_SetUp}" Padding="12,6" Margin="8,0,0,0" Visibility="Collapsed" Click="OnAdminTierInstall" />
          <Button x:Name="AdminTierUpdate" Content="{l:S About_AdminTier_Update}" Padding="12,6" Margin="8,0,0,0" Visibility="Collapsed" Click="OnAdminTierInstall" />
          <Button x:Name="AdminTierRemove" Content="{l:S About_AdminTier_Remove}" Padding="12,6" Margin="8,0,0,0" Visibility="Collapsed" Click="OnAdminTierRemove" />
        </StackPanel>
        <StackPanel>
          <TextBlock Style="{StaticResource SubtitleText}" AutomationProperties.HeadingLevel="Level2">
            <Run Text="{l:S About_AdminTier_Heading}" /><Run Text=" - " /><Run x:Name="AdminTierText" Text="{l:S About_AdminTier_Checking}" FontWeight="Normal" />
          </TextBlock>
          <TextBlock Text="{l:S About_AdminTier_What}" Style="{StaticResource CaptionText}" />
          <TextBlock x:Name="AdminTierOutcome" Style="{StaticResource CaptionText}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Border Style="{StaticResource Card}">
      <ItemsControl x:Name="Facts" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" Margin="0" />
              <TextBox Grid.Column="1" Text="{Binding Value, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                       Background="Transparent" Padding="0" MinHeight="0" TextWrapping="Wrap"
                       AutomationProperties.Name="{Binding Name}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>
    </StackPanel>

    <TextBlock x:Name="NotesHeading" Style="{StaticResource SubtitleText}" />
    <TextBox x:Name="Notes" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="{Binding Text, ElementName=NotesHeading}" />
    </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Content="{l:S About_GitHub}" Padding="12,6" Click="OnGitHub" />
        <Button Content="{l:S About_CheckUpdates}" Padding="12,6" Margin="8,0,0,0" Click="OnCheckUpdates" />
        <Button x:Name="PageButton" Padding="12,6" Margin="8,0,0,0" Click="OnPage" />
        <Button Content="{l:S Status_CopyDetails}" Padding="12,6" Margin="8,0,0,0" Click="OnCopy" />
        <Button Content="{l:S Problem_Action_DataFolder}" Padding="12,6" Margin="8,0,0,0" Click="OnDataFolder" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
