<UserControl x:Class="Tiresias.App.Views.StartupPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Tiresias.App">
  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{l:S Startup_Heading}" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
    <TextBlock Grid.Row="1" Text="{l:S Startup_Intro}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,12" MaxWidth="720"
               HorizontalAlignment="Left" />

    <WrapPanel Grid.Row="2" Margin="0,0,0,12">
      <StackPanel Margin="0,0,12,8">
        <Label x:Name="SearchLabel" Content="{l:S Installed_Search}" Target="{Binding ElementName=Search}" Padding="0,0,0,4" />
        <TextBox x:Name="Search" Width="240" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.LabeledBy="{Binding ElementName=SearchLabel}" />
      </StackPanel>
      <StackPanel Margin="0,0,12,8">
        <Label x:Name="ShowLabel" Content="{l:S Installed_ShowLabel}" Target="{Binding ElementName=Show}" Padding="0,0,0,4" />
        <ComboBox x:Name="Show" Width="220" ItemsSource="{Binding Filters}" DisplayMemberPath="Label" SelectedValuePath="Value"
                  SelectedValue="{Binding View}" AutomationProperties.LabeledBy="{Binding ElementName=ShowLabel}" />
      </StackPanel>
    </WrapPanel>

    <Grid Grid.Row="3">
      <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                GridLinesVisibility="None" CanUserAddRows="False" SelectionMode="Single"
                AutomationProperties.Name="{l:S Startup_ListName}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="{l:S Installed_ColName}" Width="3*" SortMemberPath="Name">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <DockPanel Margin="4,2">
                  <!-- The same marks as Installed (Logic/ProgramMarks), plus Off for an entry that no longer starts. -->
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Border Visibility="{Binding OffVisibility}" CornerRadius="4" Padding="5,0" Margin="0,0,6,0" VerticalAlignment="Center"
                            BorderThickness="1" BorderBrush="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{l:S Startup_OffTip}">
                      <TextBlock Text="{l:S Startup_Off}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Visibility="{Binding UnsignedVisibility}"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" ToolTip="{l:S Installed_UnsignedTip}" />
                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Visibility="{Binding BuiltByYouVisibility}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" ToolTip="{l:S Program_BuiltByYouTip}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{l:S Startup_ColApp}" Binding="{Binding App}" Width="2*" />
          <DataGridTextColumn Header="{l:S Startup_ColFrom}" Binding="{Binding From}" Width="1.4*" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{Binding EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>

    <!-- The selected entry in full, with what can be done about it. -->
    <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding DetailsVisibility}"
            AutomationProperties.Name="{Binding Selected.Spoken}">
      <Grid DataContext="{Binding Selected}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.ColumnSpan="2" Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" Text="{l:S Startup_ColProgram}" Style="{StaticResource CaptionText}" Margin="0,2,16,2" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Program, Mode=OneWay}" Style="{StaticResource SelectableText}" TextWrapping="Wrap"
                 AutomationProperties.Name="{l:S Startup_ColProgram}" />
        <TextBlock Grid.Row="2" Text="{l:S Startup_ColFrom}" Style="{StaticResource CaptionText}" Margin="0,2,16,2" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding From}" TextWrapping="Wrap" Margin="0,2" />
        <TextBlock Grid.Row="3" Text="{l:S Startup_ColState}" Style="{StaticResource CaptionText}" Margin="0,2,16,2" />
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding State}" TextWrapping="Wrap" Margin="0,2" />
        <TextBlock Grid.Row="4" Text="{l:S Startup_ColApp}" Style="{StaticResource CaptionText}" Margin="0,2,16,2" />
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding App}" TextWrapping="Wrap" Margin="0,2" />
        <TextBlock Grid.Row="5" Text="{l:S Startup_ColOpened}" Style="{StaticResource CaptionText}" Margin="0,2,16,2" />
        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Opened}" TextWrapping="Wrap" Margin="0,2" />
        <TextBlock Grid.Row="6" Text="{l:S Installed_ColReached}" Style="{StaticResource CaptionText}" Margin="0,2,16,2" />
        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Reached}" TextWrapping="Wrap" Margin="0,2" />
        <TextBlock Grid.Row="7" Text="{l:S Installed_ColSigner}" Style="{StaticResource CaptionText}" Margin="0,2,16,2" />
        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Signer}" TextWrapping="Wrap" Margin="0,2" />
        <WrapPanel Grid.Row="8" Grid.ColumnSpan="2" Margin="0,8,0,0">
          <Button Style="{StaticResource RowButton}" Content="{l:S Startup_TurnOff}" Click="OnTurnOff" Margin="0,0,8,0"
                  Visibility="{Binding TurnOffVisibility}" ToolTip="{l:S Startup_TurnOffTip}" />
          <Button Style="{StaticResource RowButton}" Content="{l:S Finding_FixReveal}" Click="OnReveal" Margin="0,0,8,0"
                  Visibility="{Binding RevealVisibility}" />
        </WrapPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="5" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource RowButton}" Content="{l:S Installed_Refresh}" Command="{Binding LoadCommand}" Margin="0,0,8,0" />
        <Button Style="{DynamicResource AccentButtonStyle}" Padding="12,4" Content="{l:S Startup_OpenSettings}" Click="OnOpenSettings" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
