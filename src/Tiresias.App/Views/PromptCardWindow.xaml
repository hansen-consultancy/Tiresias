<Window x:Class="Tiresias.App.Views.PromptCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Tiresias.App"
        Title="{l:S Prompt_WindowTitle}"
        l:WindowFit.Size="None" Width="456" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" Focusable="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
        Icon="pack://application:,,,/Tiresias;component/Assets/tiresias.ico">
  <!-- Nothing to click: it says why the prompt Windows is about to show, and goes when that prompt is answered. -->
  <Grid Margin="20,16,20,18">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Image Source="pack://application:,,,/Tiresias;component/Assets/tiresias.ico" Width="32" Height="32"
           VerticalAlignment="Top" Margin="0,2,14,0" />
    <StackPanel Grid.Column="1">
      <TextBlock x:Name="Heading" Style="{StaticResource SubtitleText}" AutomationProperties.HeadingLevel="Level1" />
      <TextBlock x:Name="Reason" Style="{StaticResource BodyText}" Margin="0" />
    </StackPanel>
  </Grid>
</Window>
