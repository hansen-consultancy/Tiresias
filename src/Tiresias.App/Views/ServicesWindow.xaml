<Window x:Class="Tiresias.App.Views.ServicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Tiresias.App"
        xmlns:v="clr-namespace:Tiresias.App.Views"
        Title="{l:S Services_WindowTitle}"
        Width="860" Height="680" MinWidth="600" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/tiresias.ico">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
      <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Style.Triggers>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Field" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
  </Window.Resources>
  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{l:S Services_Heading}" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />

    <Border Grid.Row="1" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding State}" Style="{StaticResource BodyText}" Margin="0" VerticalAlignment="Center" />
        <Button Grid.Column="1" Margin="12,0,0,0" Style="{DynamicResource AccentButtonStyle}" Padding="12,6" Content="{l:S Tray_Unlock}"
                Command="{Binding UnlockCommand}" Visibility="{Binding NeedsUnlock, Converter={StaticResource Visible}}" />
      </Grid>
    </Border>

    <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
              SelectedItem="{Binding SelectedRow}" AutomationProperties.Name="{l:S Services_ListName}"
              Visibility="{Binding IsListing, Converter={StaticResource Visible}}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:S Services_ColSlug}" Binding="{Binding Slug}" Width="Auto" />
        <DataGridTextColumn Header="{l:S Services_ColUpstream}" Binding="{Binding Upstream}" Width="*" />
        <DataGridTemplateColumn Header="{l:S Services_ColGrants}" Width="2*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Grants}" TextWrapping="Wrap" Margin="4,2" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsAdding, Converter={StaticResource Visible}}">
      <StackPanel MaxWidth="640" HorizontalAlignment="Left">
        <TextBlock Text="{l:S Services_AddHeading}" Style="{StaticResource SubtitleText}" Margin="0,0,0,12" AutomationProperties.HeadingLevel="Level2" />

        <StackPanel Style="{StaticResource Field}">
          <Label x:Name="SlugLabel" Content="{l:S Services_Slug}" Target="{Binding ElementName=SlugBox}" Padding="0,0,0,4" />
          <TextBox x:Name="SlugBox" Text="{Binding Slug, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.LabeledBy="{Binding ElementName=SlugLabel}" />
          <TextBlock Text="{l:S Services_SlugHint}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding SlugError}" Style="{StaticResource FieldError}" />
        </StackPanel>

        <StackPanel Style="{StaticResource Field}">
          <Label x:Name="UpstreamLabel" Content="{l:S Services_Upstream}" Target="{Binding ElementName=UpstreamBox}" Padding="0,0,0,4" />
          <TextBox x:Name="UpstreamBox" Text="{Binding Upstream, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.LabeledBy="{Binding ElementName=UpstreamLabel}" />
          <TextBlock Text="{l:S Services_UpstreamHint}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding UpstreamError}" Style="{StaticResource FieldError}" />
        </StackPanel>

        <StackPanel Style="{StaticResource Field}">
          <Label x:Name="SecretLabel" Content="{l:S Services_Secret}" Target="{Binding ElementName=SecretBox}" Padding="0,0,0,4" />
          <ComboBox x:Name="SecretBox" IsEditable="True" ItemsSource="{Binding Secrets}" Text="{Binding Secret, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.LabeledBy="{Binding ElementName=SecretLabel}" />
          <TextBlock Text="{Binding SecretHint}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding SecretError}" Style="{StaticResource FieldError}" />
        </StackPanel>

        <StackPanel Style="{StaticResource Field}" Visibility="{Binding NeedsValue, Converter={StaticResource Visible}}">
          <Label x:Name="ValueLabel" Content="{l:S Services_Value}" Target="{Binding ElementName=ValueBox}" Padding="0,0,0,4" />
          <PasswordBox x:Name="ValueBox" v:Password.Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.LabeledBy="{Binding ElementName=ValueLabel}" />
          <TextBlock Text="{l:S Services_ValueHint}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding ValueError}" Style="{StaticResource FieldError}" />
        </StackPanel>

        <StackPanel Style="{StaticResource Field}">
          <Label x:Name="MethodsLabel" Content="{l:S Services_Methods}" Target="{Binding ElementName=MethodsBox}" Padding="0,0,0,4" />
          <TextBox x:Name="MethodsBox" Text="{Binding Methods, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.LabeledBy="{Binding ElementName=MethodsLabel}" />
          <TextBlock Text="{l:S Services_MethodsHint}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding MethodsError}" Style="{StaticResource FieldError}" />
        </StackPanel>

        <StackPanel Style="{StaticResource Field}">
          <Label x:Name="AllowLabel" Content="{l:S Services_Allow}" Target="{Binding ElementName=AllowBox}" Padding="0,0,0,4" />
          <TextBox x:Name="AllowBox" Text="{Binding Allow, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinLines="3"
                   FontFamily="Cascadia Mono, Consolas" AutomationProperties.LabeledBy="{Binding ElementName=AllowLabel}" />
          <TextBlock Text="{Binding AllowHint}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding AllowError}" Style="{StaticResource FieldError}" />
        </StackPanel>

        <StackPanel Style="{StaticResource Field}">
          <CheckBox IsChecked="{Binding Elevation}" Content="{l:S Services_Elevation}" />
          <TextBlock Text="{l:S Services_ElevationHint}" Style="{StaticResource CaptionText}" Margin="28,0,0,0" />
        </StackPanel>

        <StackPanel Style="{StaticResource ButtonRow}" HorizontalAlignment="Left" Margin="0,4,0,0">
          <Button Style="{DynamicResource AccentButtonStyle}" MinWidth="96" Padding="12,6" Content="{l:S Services_Save}" Command="{Binding SaveCommand}" IsDefault="True" />
          <Button Style="{StaticResource RowButton}" Content="{l:S Services_Cancel}" Command="{Binding CancelCommand}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="3" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Visibility="{Binding IsListing, Converter={StaticResource Visible}}">
        <Button Padding="12,6" Content="{l:S Services_Add}" Command="{Binding AddCommand}" />
        <Button Padding="12,6" Margin="8,0,0,0" Content="{l:S Services_Remove}" Command="{Binding RemoveCommand}" />
        <Button Padding="12,6" Margin="8,0,0,0" Content="{l:S Services_SetUpSql}" Command="{Binding SetUpSqlCommand}" />
        <Button Padding="12,6" Margin="8,0,0,0" Content="{l:S Services_SetUpRaven}" Command="{Binding SetUpRavenCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock Text="{Binding Message}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="420" />
        <Button Style="{StaticResource RowButton}" Content="{l:S Common_Close}" IsCancel="True" Click="OnClose" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
