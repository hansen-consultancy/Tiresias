<Window x:Class="Tiresias.App.Views.UsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Tiresias.App"
        Title="{l:S Usage_WindowTitle}"
        Width="640" SizeToContent="Height" MinWidth="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/Assets/tiresias.ico">
  <StackPanel Margin="{StaticResource PagePadding}">
    <TextBlock x:Name="Heading" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock x:Name="Body" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
        <TextBox x:Name="Snippet" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" Margin="0,8,0,8" TextWrapping="Wrap"
                 AutomationProperties.Name="{l:S Usage_SnippetName}" />
        <Button HorizontalAlignment="Left" Padding="12,6" Content="{l:S Sql_Copy}" Click="OnCopy" />
        <TextBlock x:Name="Hint" Style="{StaticResource Hint}" Margin="0,12,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <StackPanel Style="{StaticResource ButtonRow}">
      <Button Style="{StaticResource RowButton}" Content="{l:S Common_Close}" IsCancel="True" IsDefault="True" Click="OnClose" />
    </StackPanel>
  </StackPanel>
</Window>
