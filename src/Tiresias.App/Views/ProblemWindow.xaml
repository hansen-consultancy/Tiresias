<Window x:Class="Tiresias.App.Views.ProblemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Tiresias.App"
        l:WindowFit.Size="Narrow" ResizeMode="NoResize" ShowInTaskbar="True"
        Icon="pack://application:,,,/Assets/tiresias.ico">
  <StackPanel Margin="{StaticResource PagePadding}">
    <TextBlock x:Name="Heading" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
    <TextBlock x:Name="What" Style="{StaticResource BodyText}" />
    <TextBlock Text="{l:S Problem_WhyLabel}" Style="{StaticResource SubtitleText}" Margin="0,8,0,4" />
    <TextBlock x:Name="Why" Style="{StaticResource BodyText}" />
    <TextBlock Text="{l:S Problem_NextLabel}" Style="{StaticResource SubtitleText}" Margin="0,8,0,4" />
    <TextBlock x:Name="Next" Style="{StaticResource BodyText}" />
    <TextBlock x:Name="Copied" Style="{StaticResource CaptionText}" Text="{l:S Problem_Copied}" Visibility="Collapsed" Margin="0,8,0,0" />
    <Grid Margin="0,16,0,0">
      <Button x:Name="CopyDetails" HorizontalAlignment="Left" Padding="12,6" Click="OnCopyDetails"
              Content="{l:S Problem_CopyDetails}" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ActionButton" Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0" MinWidth="96" Padding="12,6"
                Click="OnAction" IsDefault="True" />
        <Button Style="{StaticResource RowButton}" Content="{l:S Common_Close}" IsCancel="True" Click="OnClose" />
      </StackPanel>
    </Grid>
  </StackPanel>
</Window>
