<UserControl x:Class="Tiresias.App.Views.SecretsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Tiresias.App"
        xmlns:v="clr-namespace:Tiresias.App.Views">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
  </UserControl.Resources>
  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{l:S Secrets_Heading}" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />

    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <Label x:Name="ProjectLabel" Content="{l:S Secrets_Project}" Target="{Binding ElementName=Project}" Padding="0,0,0,4" />
        <!-- Typing a project's first letters jumps to it: labels start with the name. -->
        <ComboBox x:Name="Project" ItemsSource="{Binding ProjectView}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedProject}"
                  TextSearch.TextPath="Label" AutomationProperties.LabeledBy="{Binding ElementName=ProjectLabel}">
          <ComboBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="8,8,0,4" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ComboBox.GroupStyle>
        </ComboBox>
      </StackPanel>
      <Button Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,0" Padding="12,6" Content="{l:S Secrets_FindProject}"
              Command="{Binding FindProjectCommand}" />
    </Grid>

    <StackPanel Grid.Row="2" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding SelectedDetail}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding SelectedDetail}" />
        <Button Grid.Column="1" Padding="12,4" Margin="12,0,0,0" Content="{l:S Secrets_Recycle}" Command="{Binding RecycleSelectedCommand}"
                Visibility="{Binding CanRecycleSelected, Converter={StaticResource Visible}}" />
      </Grid>
      <!-- Every checkout using the id, on demand: a repository with 28 worktrees is one line until asked (docs/app-design.md, rule 6). -->
      <Expander Header="{Binding SelectedPathsHeader}" Visibility="{Binding SelectedPathsVisibility}" Margin="0,4,0,0">
        <ItemsControl ItemsSource="{Binding SelectedPaths}" Focusable="False" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBox Text="{Binding Mode=OneWay}" Style="{StaticResource SelectableText}" FontSize="12" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>
      <Expander Header="{l:S Secrets_Folders}" Margin="0,8,0,0">
        <StackPanel Margin="0,8,0,0">
          <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource CaptionText}" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite" />
          <ItemsControl ItemsSource="{Binding Folders}" AutomationProperties.Name="{l:S Secrets_FoldersName}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" Margin="0" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Padding="10,2" Content="{l:S Secrets_RemoveFolder}" CommandParameter="{Binding}"
                          Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          AutomationProperties.Name="{Binding Converter={x:Static v:RemoveFolderName.Instance}}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Padding="12,6" Content="{l:S Secrets_AddFolder}" Command="{Binding AddFolderCommand}" />
            <Button Padding="12,6" Margin="8,0,0,0" Content="{l:S Secrets_ScanNow}" Command="{Binding ScanNowCommand}" />
            <Button Padding="12,6" Margin="8,0,0,0" Content="{Binding RecycleUnusedLabel}" Command="{Binding RecycleUnusedCommand}"
                    Visibility="{Binding HasUnused, Converter={StaticResource Visible}}" />
          </StackPanel>
        </StackPanel>
      </Expander>
      <!-- Empty folders stay out of the picker until asked for (docs/app-design.md, section 12). -->
      <Grid Margin="0,8,0,0" Visibility="{Binding HasEmpty, Converter={StaticResource Visible}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center">
          <Hyperlink Command="{Binding ToggleEmptyCommand}"><Run Text="{Binding EmptyFoldersLabel, Mode=OneWay}" /></Hyperlink>
        </TextBlock>
        <Button Grid.Column="1" Padding="12,4" Margin="12,0,0,0" Content="{Binding RecycleEmptyLabel}" Command="{Binding RecycleEmptyCommand}" />
      </Grid>
    </StackPanel>

    <Border Grid.Row="3" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding State}" Style="{StaticResource BodyText}" Margin="0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
          <Button Style="{DynamicResource AccentButtonStyle}" Padding="12,6" Content="{l:S Tray_Unlock}"
                  Command="{Binding UnlockCommand}" Visibility="{Binding NeedsUnlock, Converter={StaticResource Visible}}" />
          <Button Style="{DynamicResource AccentButtonStyle}" Padding="12,6" Content="{l:S Secrets_SealNow}"
                  Command="{Binding SaveCommand}" Visibility="{Binding IsPlain, Converter={StaticResource Visible}}" />
          <Button Padding="12,6" Content="{l:S Secrets_StoreInClear}"
                  Command="{Binding StoreInClearCommand}" Visibility="{Binding IsSealed, Converter={StaticResource Visible}}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Every binding in a row says UpdateSourceTrigger=PropertyChanged: without it the row's
         binding group holds the value until the row commits, so Show did nothing. -->
    <DataGrid Grid.Row="4" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
              HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" SelectedItem="{Binding SelectedRow}"
              Visibility="{Binding CanEdit, Converter={StaticResource Visible}}" AutomationProperties.Name="{l:S Secrets_ListName}">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="{l:S Secrets_ColKey}" Width="*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent"
                       AutomationProperties.Name="{l:S Secrets_ColKey}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="{l:S Secrets_ColValue}" Width="2*">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Grid>
                <PasswordBox v:Password.Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent"
                             Visibility="{Binding IsHidden, Converter={StaticResource Visible}}"
                             AutomationProperties.Name="{l:S Secrets_ValueHidden}" />
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent"
                         Visibility="{Binding IsRevealed, Converter={StaticResource Visible}}"
                         AutomationProperties.Name="{l:S Secrets_ColValue}" />
              </Grid>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <!-- An Auto column beside star columns is sized once, often before any row exists, so it
             stayed too narrow for the button. A hidden copy in the header holds its width. -->
        <DataGridTemplateColumn Width="Auto">
          <DataGridTemplateColumn.Header>
            <ToggleButton Visibility="Hidden" Padding="8,2" Margin="4,2" Content="{l:S Secrets_Show}" />
          </DataGridTemplateColumn.Header>
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <ToggleButton IsChecked="{Binding IsRevealed, UpdateSourceTrigger=PropertyChanged}" Padding="8,2" Margin="4,2"
                            Content="{l:S Secrets_Show}" AutomationProperties.Name="{l:S Secrets_ShowName}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- The key in full; never the value, which stays behind Show in its own cell. -->
    <v:DetailsPanel Grid.Row="5" Fields="{Binding SelectedRow.Details}" />

    <Grid Grid.Row="6" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
        <Button Padding="12,6" Content="{l:S Secrets_Add}" Command="{Binding AddCommand}" />
        <Button Padding="12,6" Margin="8,0,0,0" Content="{l:S Secrets_Remove}" Command="{Binding RemoveCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <TextBlock Text="{Binding Message}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="320" />
        <Button Style="{DynamicResource AccentButtonStyle}" MinWidth="96" Padding="12,6" Content="{l:S Secrets_Save}"
                Command="{Binding SaveCommand}" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
