<Window x:Class="Tiresias.App.Views.ServiceIncidentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Tiresias.App" Title="{l:S AdminIncidents_Title}"
        Width="850" Height="460" WindowStartupLocation="CenterOwner"
        Icon="pack://application:,,,/Assets/tiresias.ico">
  <DockPanel Margin="{StaticResource PagePadding}">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="Status" Style="{StaticResource CaptionText}" AutomationProperties.LiveSetting="Polite" />
      <WrapPanel HorizontalAlignment="Right">
        <Button x:Name="Review" Style="{StaticResource RowButton}" Content="{l:S AdminIncidents_Review}" IsEnabled="False" Click="OnReview" />
        <Button x:Name="Refresh" Style="{StaticResource RowButton}" Content="{l:S Activity_Refresh}" Click="OnRefresh" />
        <Button Style="{StaticResource RowButton}" Content="{l:S Common_Close}" IsCancel="True" />
      </WrapPanel>
    </StackPanel>
    <DataGrid x:Name="History" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
              AutomationProperties.Name="{l:S AdminIncidents_Title}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="{l:S Activity_ColTime}" Binding="{Binding Time}" Width="140" />
        <DataGridTextColumn Header="{l:S Activity_ColWho}" Binding="{Binding Program}" Width="2*" />
        <DataGridTextColumn Header="{l:S Activity_ColDetail}" Binding="{Binding Detail}" Width="3*" />
        <DataGridCheckBoxColumn Header="{l:S AdminIncidents_Reviewed}" Binding="{Binding Reviewed, Mode=OneWay}" Width="Auto" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
