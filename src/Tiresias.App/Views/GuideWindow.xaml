<Window x:Class="Tiresias.App.Views.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Tiresias.App"
        l:WindowFit.Size="Standard" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Icon="pack://application:,,,/Assets/tiresias.ico">
  <!-- Steps to close a finding Tiresias can't close itself, in the app instead of a web page:
       each with the exact command to copy, and Run as administrator where it needs one. -->
  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="Heading" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
      <TextBlock Text="{l:S Guide_Intro}" Style="{StaticResource BodyText}" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="560" Margin="0,12,0,0">
      <ItemsControl x:Name="Steps" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="22" Height="22" CornerRadius="11" VerticalAlignment="Top"
                      Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <TextBlock Text="{Binding Number}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Text}" Style="{StaticResource BodyText}" />
                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,6,0,0" Visibility="{Binding CopyVisibility}">
                  <TextBox Text="{Binding Copy, Mode=OneWay}" Style="{StaticResource SelectableText}"
                           AutomationProperties.Name="{Binding Text}" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding CopyVisibility}">
                  <Button Content="{l:S Guide_Copy}" Padding="12,4" AutomationProperties.Name="{Binding CopyName}" Click="OnCopy" />
                  <Button Content="{l:S Guide_RunAdmin}" Padding="12,4" Margin="8,0,0,0" ToolTip="{l:S Guide_RunAdminTip}"
                          Visibility="{Binding AdminVisibility}" Click="OnRunAdmin" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <StackPanel Grid.Row="2">
      <TextBox x:Name="Message" Style="{StaticResource SelectableText}" FontFamily="{x:Static SystemFonts.MessageFontFamily}"
               Visibility="Collapsed" Margin="0,0,0,8" />
      <Grid>
        <Button HorizontalAlignment="Left" Padding="12,6" Content="{l:S Guide_ReadMore}" Click="OnReadMore" />
        <Button HorizontalAlignment="Right" Style="{StaticResource RowButton}" Content="{l:S Common_Close}" IsCancel="True" IsDefault="True" />
      </Grid>
    </StackPanel>
  </Grid>
</Window>
