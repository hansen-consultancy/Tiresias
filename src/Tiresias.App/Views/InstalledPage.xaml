<UserControl x:Class="Tiresias.App.Views.InstalledPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Tiresias.App"
        xmlns:v="clr-namespace:Tiresias.App.Views">
  <Grid Margin="{StaticResource PagePadding}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="{l:S Installed_Heading}" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
    <TextBlock Grid.Row="1" Text="{l:S Installed_Intro}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,12" MaxWidth="720"
               HorizontalAlignment="Left" />

    <WrapPanel Grid.Row="2" Margin="0,0,0,12">
      <StackPanel Margin="0,0,12,8">
        <Label x:Name="SearchLabel" Content="{l:S Installed_Search}" Target="{Binding ElementName=Search}" Padding="0,0,0,4" />
        <TextBox x:Name="Search" Width="240" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.LabeledBy="{Binding ElementName=SearchLabel}" />
      </StackPanel>
      <StackPanel Margin="0,0,12,8">
        <Label x:Name="ShowLabel" Content="{l:S Installed_ShowLabel}" Target="{Binding ElementName=Show}" Padding="0,0,0,4" />
        <ComboBox x:Name="Show" Width="200" ItemsSource="{Binding Filters}" DisplayMemberPath="Label" SelectedValuePath="Value"
                  SelectedValue="{Binding View}" AutomationProperties.LabeledBy="{Binding ElementName=ShowLabel}" />
      </StackPanel>
      <!-- Off by default: the only thing the app sends anywhere about what is installed (docs/attack-surface.md#trust). -->
      <CheckBox Content="{l:S Installed_Online}" IsChecked="{Binding IsOnline}" ToolTip="{l:S Installed_OnlineTip}"
                VerticalAlignment="Bottom" Margin="0,0,12,12" />
    </WrapPanel>

    <Grid Grid.Row="3">
      <!-- Two columns that fit any width; everything else about the selected program is in the panel below. -->
      <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                GridLinesVisibility="None" CanUserAddRows="False" SelectionMode="Single"
                AutomationProperties.Name="{l:S Installed_ListName}">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="{l:S Installed_ColName}" Width="3*" SortMemberPath="Name">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <DockPanel Margin="4,2">
                  <Grid Width="16" Height="16" Margin="0,0,8,0" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image Source="{Binding Icon}" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="&#xE74C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Visibility="{Binding GenericIconVisibility}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                  <!-- Quiet marks at the end of the name: New (installed lately), an unsigned program file or the user's own build. -->
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Border Visibility="{Binding NewVisibility}" CornerRadius="4" Padding="5,0" Margin="0,0,6,0" VerticalAlignment="Center"
                            BorderThickness="1" BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}" ToolTip="{x:Static v:InstalledRow.NewTip}">
                      <TextBlock Text="{l:S Installed_New}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Visibility="{Binding UnsignedVisibility}"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" VerticalAlignment="Center" ToolTip="{l:S Installed_UnsignedTip}" />
                    <!-- Unsigned, but the user's own build where developer tools show (#148): information, not a caution. -->
                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" Visibility="{Binding BuiltByYouVisibility}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" ToolTip="{l:S Program_BuiltByYouTip}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="{l:S Installed_ColUse}" Binding="{Binding ShortUse}" Width="2*" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{Binding EmptyText}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Grid>

    <!-- The selected program in full: values wrap, the folder can be selected and copied. -->
    <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding DetailsVisibility}"
            AutomationProperties.Name="{Binding Selected.Spoken}">
      <Grid DataContext="{Binding Selected}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.ColumnSpan="2" Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" Text="{l:S Installed_ColVersion}" Style="{StaticResource CaptionText}" Margin="0,2,16,2" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Version}" TextWrapping="Wrap" Margin="0,2" />
        <TextBlock Grid.Row="2" Text="{l:S Installed_ColFor}" Style="{StaticResource CaptionText}" Margin="0,2,16,2" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding For}" TextWrapping="Wrap" Margin="0,2" />
        <TextBlock Grid.Row="3" Text="{l:S Installed_ColInstalledOn}" Style="{StaticResource CaptionText}" Margin="0,2,16,2" />
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InstalledOn}" TextWrapping="Wrap" Margin="0,2" />
        <TextBlock Grid.Row="4" Text="{l:S Installed_ColUse}" Style="{StaticResource CaptionText}" Margin="0,2,16,2" />
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Use}" TextWrapping="Wrap" Margin="0,2" />
        <TextBlock Grid.Row="5" Text="{l:S Installed_ColReached}" Style="{StaticResource CaptionText}" Margin="0,2,16,2" />
        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Reached}" TextWrapping="Wrap" Margin="0,2" />
        <TextBlock Grid.Row="6" Text="{l:S Installed_ColFolder}" Style="{StaticResource CaptionText}" Margin="0,2,16,2" />
        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Folder, Mode=OneWay}" Style="{StaticResource SelectableText}" TextWrapping="Wrap"
                 AutomationProperties.Name="{l:S Installed_ColFolder}" />
        <TextBlock Grid.Row="7" Text="{l:S Installed_ColPublisher}" Style="{StaticResource CaptionText}" Margin="0,2,16,2" />
        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Publisher}" TextWrapping="Wrap" Margin="0,2" />
        <TextBlock Grid.Row="8" Text="{l:S Installed_ColSigner}" Style="{StaticResource CaptionText}" Margin="0,2,16,2" />
        <TextBlock Grid.Row="8" Grid.Column="1" x:Name="SignerText" Text="{Binding DataContext.Signer, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   TextWrapping="Wrap" Margin="0,2" />
        <!-- Trust goes to the valid signature's publisher only; the panel's other button row stays Search online. -->
        <TextBlock Grid.Row="9" Text="{l:S Installed_ColTrust}" Style="{StaticResource CaptionText}" Margin="0,2,16,2" />
        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding DataContext.Trust, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   TextWrapping="Wrap" Margin="0,2" />
        <!-- A global tool only: what the online lookups said, beside the offline signer. -->
        <TextBlock Grid.Row="10" Text="{l:S Installed_ColOnline}" Style="{StaticResource CaptionText}" Margin="0,2,16,2"
                   Visibility="{Binding DataContext.OnlineVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding DataContext.Online, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   TextWrapping="Wrap" Margin="0,2"
                   Visibility="{Binding DataContext.OnlineVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        <WrapPanel Grid.Row="11" Grid.ColumnSpan="2" Margin="0,8,0,0">
          <Button Style="{StaticResource RowButton}" Content="{l:S Installed_SearchOnline}" Click="OnSearchOnline"
                  Margin="0,0,8,0" ToolTip="{l:S Installed_SearchOnlineTip}" />
          <Button Style="{StaticResource RowButton}" Click="OnTrust" ToolTip="{l:S Installed_TrustTip}"
                  Content="{Binding DataContext.TrustButton, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Visibility="{Binding DataContext.TrustButtonVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </WrapPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="5" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource RowButton}" Content="{l:S Installed_Refresh}" Command="{Binding LoadCommand}" Margin="0,0,8,0" />
        <Button Style="{DynamicResource AccentButtonStyle}" Padding="12,4" Content="{l:S Installed_OpenSettings}" Click="OnOpenSettings" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
