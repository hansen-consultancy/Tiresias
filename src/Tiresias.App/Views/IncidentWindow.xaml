<Window x:Class="Tiresias.App.Views.IncidentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Tiresias.App"
        Title="{l:S Incident_WindowTitle}"
        Width="560" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True"
        Icon="pack://application:,,,/Assets/tiresias.ico">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="{StaticResource PagePadding}">
      <TextBlock Text="{l:S Incident_Heading}" Style="{StaticResource TitleText}" AutomationProperties.HeadingLevel="Level1" />
      <TextBlock x:Name="What" Style="{StaticResource BodyText}" />

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock x:Name="ProgramLabel" Text="{l:S Incident_ProgramLabel}" Style="{StaticResource CaptionText}" />
          <TextBlock x:Name="ProgramName" Style="{StaticResource MonoText}" FontWeight="SemiBold" Margin="0,2,0,0"
                     AutomationProperties.LabeledBy="{Binding ElementName=ProgramLabel}" />
          <TextBox x:Name="ProgramFolder" Style="{StaticResource SelectableText}" Margin="0,2,0,0" Opacity="0.75" />
          <TextBlock x:Name="OpenFolderLine" Margin="0,4,0,0">
            <Hyperlink Click="OnOpenFolder"><Run Text="{l:S Consent_OpenFolder}" /></Hyperlink>
          </TextBlock>
          <TextBlock x:Name="Blocked" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
          <TextBlock x:Name="ParentsLabel" Text="{l:S Incident_ParentsLabel}" Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
          <TextBox x:Name="Parents" Style="{StaticResource SelectableText}" Margin="0,2,0,0"
                   AutomationProperties.LabeledBy="{Binding ElementName=ParentsLabel}" />
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ProcessState" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            <Button x:Name="EndProcess" Grid.Column="1" Padding="12,6" Margin="12,0,0,0" Content="{l:S Incident_EndProcess}" Click="OnEndProcess" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Text="{l:S Incident_ScanLabel}" Style="{StaticResource SubtitleText}" />
      <TextBlock Text="{l:S Incident_ScanBody}" Style="{StaticResource BodyText}" />
      <TextBlock Margin="0,0,0,8">
        <Hyperlink Click="OnOpenSecurity"><Run Text="{l:S Incident_OpenSecurity}" /></Hyperlink>
      </TextBlock>
      <TextBlock Text="{l:S Incident_Unlock}" Style="{StaticResource CaptionText}" />

      <StackPanel Style="{StaticResource ButtonRow}">
        <Button Style="{StaticResource RowButton}" Content="{l:S Incident_Status}" Click="OnStatus" />
        <Button Style="{StaticResource RowButton}" Content="{l:S Common_Close}" IsCancel="True" Click="OnClose" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
