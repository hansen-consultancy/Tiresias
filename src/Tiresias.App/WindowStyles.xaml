<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:Tiresias.App.Views">
  <Thickness x:Key="PagePadding">24,20,24,20</Thickness>
  <Thickness x:Key="SectionGap">0,0,0,16</Thickness>

  <Style x:Key="TitleText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style x:Key="SubtitleText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <Style x:Key="CaptionText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
  </Style>
  <Style x:Key="MonoText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- Reads as the mono text it replaces, but can be selected and copied. -->
  <Style x:Key="SelectableText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Margin" Value="{StaticResource SectionGap}" />
  </Style>
  <!-- A list of rows with their own controls inside a page that scrolls: one row selected at a time for the
       details panel below it, no scroll viewer of its own to swallow the wheel, no horizontal scrolling. -->
  <Style x:Key="PickList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="v:PickList.SelectsFocusedRow" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ItemsPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <!-- Compact rows; the selection is the same subtle fill as a selected grid cell, not Fluent's accent block. -->
        <Style TargetType="ListBoxItem">
          <Setter Property="FocusVisualStyle" Value="{x:Null}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="6,2">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                  </Trigger>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ButtonRow" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,16,0,0" />
  </Style>
  <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Margin" Value="8,0,0,0" />
    <Setter Property="MinWidth" Value="96" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <!-- Fluent draws a disabled grid on a white fill, which glares in dark mode: a grid waiting for
       something to be picked keeps the page's own background. -->
  <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowBackground" Value="Transparent" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- A show/hide switch for the part below it: a chevron and its label in the text colour, with no
       fill when on, so it reads the same in light and dark (Fluent's checked fill is a pale grey). -->
  <Style x:Key="DisclosureToggle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="Chevron" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                         VerticalAlignment="Center" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform><RotateTransform x:Name="Turn" Angle="0" /></TextBlock.RenderTransform>
              </TextBlock>
              <ContentPresenter VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chevron" Property="RenderTransform">
                <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
              <Setter TargetName="Back" Property="BorderThickness" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Fluent's selected cell is accent blue under unchanged black text: hard to read, and loud
       for a grid of text boxes. A subtle fill keeps the selection visible in light and dark. -->
  <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
