<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Tiresias.Tests</RootNamespace>
    <!-- Gives WebApplication.CreateBuilder a user-secrets source to add in Development, for the interceptor test. Nothing is stored under it. -->
    <UserSecretsId>tiresias-tests-0d1f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tiresias.Core\Tiresias.Core.csproj" />
    <ProjectReference Include="..\Tiresias.Broker\Tiresias.Broker.csproj" />
    <!-- Aliased: the forwarder's top-level Program would otherwise collide with the broker's. -->
    <ProjectReference Include="..\Tiresias.Forwarder\Tiresias.Forwarder.csproj" Aliases="forwarder" />
    <ProjectReference Include="..\Tiresias.Extensions.Configuration\Tiresias.Extensions.Configuration.csproj" />
    <!-- Twice on purpose: as a library to drive it in a GeneratorDriver, and as an analyzer so this
         assembly's own AddUserSecrets calls are intercepted, which proves the wiring end to end. -->
    <ProjectReference Include="..\Tiresias.Extensions.Configuration.Generator\Tiresias.Extensions.Configuration.Generator.csproj" />
    <ProjectReference Include="..\Tiresias.Extensions.Configuration.Generator\Tiresias.Extensions.Configuration.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The desktop app is Windows-only, so its pure decisions are compiled in here rather than referenced. -->
  <ItemGroup>
    <Compile Include="..\Tiresias.App\Logic\**\*.cs" Link="AppLogic\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Tiresias.Admin\PipeCallerIdentity.cs" Link="Admin\PipeCallerIdentity.cs" />
    <Compile Include="..\Tiresias.Admin\DecoyHold.cs" Link="Admin\DecoyHold.cs" />
    <Compile Include="..\Tiresias.Agent\ProcessTree.cs" Link="Agent\ProcessTree.cs" />
    <Compile Include="..\Tiresias.Agent\SourceHandle.cs" Link="Agent\SourceHandle.cs" />
    <Compile Include="..\Tiresias.Admin\ActionLog.cs" Link="Admin\ActionLog.cs" />
  </ItemGroup>

  <!-- The broker enrollment and saved offer are portable decisions shared with the Windows client. -->
  <ItemGroup>
    <Compile Include="..\Tiresias.Agent\BrokerEnrollment.cs" Link="Agent\BrokerEnrollment.cs" />
    <Compile Include="..\Tiresias.Agent\BrokerVaultAccess.cs" Link="Agent\BrokerVaultAccess.cs" />
    <Compile Include="..\Tiresias.Agent\BrokerJournalAccess.cs" Link="Agent\BrokerJournalAccess.cs" />
    <Compile Include="..\Tiresias.Agent\ServicePipeIdentity.cs" Link="Agent\ServicePipeIdentity.cs" />
    <Compile Include="..\Tiresias.Agent\HelloException.cs" Link="Agent\HelloException.cs" />
    <Compile Include="..\Tiresias.Agent\UnlockActivity.cs" Link="Agent\UnlockActivity.cs" />
  </ItemGroup>

  <!-- Likewise tir's usage and agent guide, plain text checked against each other. -->
  <ItemGroup>
    <Compile Include="..\Tiresias.Keyring\Text\*.cs" Link="KeyringText\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <!-- What the package's buildTransitive props does for a NuGet consumer. -->
  <PropertyGroup>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Tiresias.Generated</InterceptorsNamespaces>
  </PropertyGroup>

</Project>
