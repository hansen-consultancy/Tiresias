<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The workstation agent's logic, shared by the tir CLI and the tray app: the Keyring store, broker
    client, Windows Hello wrapper, lease keeping, the user-secrets pipe, the
    solo-mode broker and the doctor probe. Windows only (Hello via WinRT,
    DPAPI, session events), built on the Windows CI leg only.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Tiresias.Agent</RootNamespace>
    <!-- LibraryImport marshalling of the pipe client PID out-parameter. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
    <PackageReference Include="NSec.Cryptography" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <!-- Solo mode hosts the broker in-process, on loopback. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tiresias.Broker\Tiresias.Broker.csproj" />
    <ProjectReference Include="..\Tiresias.Core\Tiresias.Core.csproj" />
  </ItemGroup>

</Project>
