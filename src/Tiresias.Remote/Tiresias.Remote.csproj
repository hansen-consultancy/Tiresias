<Project Sdk="Microsoft.NET.Sdk">

  <!--
    tir-remote: runs inside a devcontainer and asks the Tiresias app on the host for sealed
    variables, with the devcontainer's ticket (docs/devcontainers.md). Linux in practice; holds no
    key and stores nothing. Publishing it (and the devcontainer feature) is phase 6c.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>tir-remote</AssemblyName>
    <RootNamespace>Tiresias.Remote</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tiresias.Protocol\Tiresias.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tiresias.Tests" />
  </ItemGroup>

</Project>
