<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The optional admin tier's Windows service, TiresiasAdmin (docs/admin-tier.md). Runs as
    LocalSystem from %ProgramFiles%\Tiresias\Admin, where the app's install step copies it; never
    from the app's per-user folder. Serves \\.\pipe\tiresias.admin, refusing what
    AdminCallerPolicy refuses. Published self-contained into the app's admin\ folder. Windows only.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>tiresias-admin</AssemblyName>
    <RootNamespace>Tiresias.Admin</RootNamespace>
    <!-- LibraryImport marshalling of the token and process queries. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tiresias.Core\Tiresias.Core.csproj" />
    <ProjectReference Include="..\Tiresias.Protocol\Tiresias.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The decoys' callers are named as the agent names them: the TCP table, then the processes that started them. -->
    <Compile Include="..\Tiresias.Forwarder\TcpConnectionOwner.cs" Link="TcpConnectionOwner.cs" />
    <Compile Include="..\Tiresias.Agent\ProcessTree.cs" Link="ProcessTree.cs" />
  </ItemGroup>

</Project>
