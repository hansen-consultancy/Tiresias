<Project>
  <PropertyGroup>
    <Authors>Steve Hansen</Authors>
    <Copyright>Copyright (c) 2026 Steve Hansen</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/hansen-consultancy/Tiresias</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hansen-consultancy/Tiresias</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>secrets;credentials;user-secrets;vault;ai-agents;windows-hello</PackageTags>
    <VersionPrefix>0.2.0</VersionPrefix>
    <!-- Local builds only: both release workflows set Version from the tag. "dev" keeps a local
         build from claiming a released version, and needs no bump after a release. -->
    <VersionSuffix>dev</VersionSuffix>
    <PackageReleaseNotes>What changed in each release: https://github.com/hansen-consultancy/Tiresias/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets/export/nuget-icon.png" Pack="true" PackagePath="/icon.png" Visible="false" />
  </ItemGroup>
</Project>
