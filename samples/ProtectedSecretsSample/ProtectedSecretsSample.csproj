<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    A minimal ASP.NET Core app whose user secrets Tiresias protects. Not in Tiresias.slnx and not
    packed: it is here to try the library by hand (docs/testing-on-windows.md).
    It references the library as a project; an app outside this repository uses the package instead:
      <PackageReference Include="Tiresias.Extensions.Configuration" Version="..." />
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UserSecretsId>tiresias-sample-2f7c</UserSecretsId>
  </PropertyGroup>

  <!-- What the package does for you: the library, its interceptor generator, and the namespace opt-in from its buildTransitive props. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Tiresias.Extensions.Configuration\Tiresias.Extensions.Configuration.csproj" />
    <ProjectReference Include="..\..\src\Tiresias.Extensions.Configuration.Generator\Tiresias.Extensions.Configuration.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <PropertyGroup>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Tiresias.Generated</InterceptorsNamespaces>
  </PropertyGroup>

</Project>
